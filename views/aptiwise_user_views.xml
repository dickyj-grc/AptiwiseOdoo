<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_aptiwise" model="ir.ui.view">
        <field name="name">res.users.form.aptiwise</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Aptiwise" name="aptiwise" groups="base.group_system">
                    <group>
                        <field name="aptiwise_email"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
