<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_aptiwise_workflow_list" model="ir.ui.view">
        <field name="name">aptiwise.workflow.list</field>
        <field name="model">aptiwise.workflow</field>
        <field name="arch" type="xml">
            <list string="Aptiwise Workflows">
                <field name="name"/>
                <field name="key"/>
                <field name="url"/>
                <field name="scope"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_aptiwise_workflow_form" model="ir.ui.view">
        <field name="name">aptiwise.workflow.form</field>
        <field name="model">aptiwise.workflow</field>
        <field name="arch" type="xml">
            <form string="Aptiwise Workflow">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="key"/>
                        <field name="url"/>
                        <field name="scope"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_aptiwise_workflow" model="ir.actions.act_window">
        <field name="name">Aptiwise Workflows</field>
        <field name="res_model">aptiwise.workflow</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register an Aptiwise workflow</p>
            <p>Map a logical key (used from buttons and code) to a workflow trigger URL.</p>
        </field>
    </record>

    <menuitem id="menu_aptiwise_root"
              name="Aptiwise"
              parent="base.menu_administration"
              groups="base.group_system"
              sequence="90"/>

    <menuitem id="menu_aptiwise_workflow"
              name="Workflows"
              parent="menu_aptiwise_root"
              action="action_aptiwise_workflow"
              groups="base.group_system"
              sequence="10"/>

</odoo>
